{
  "name": "@vlln/evo-engineering",
  "description": "进化工程（Evolution Engineering）：把 RSI 变成使用 agent 的方式 —— /evo 命令 + evo_* 工具（evo_init/evo_round/evo_status/evo_rollback），基于官方 workflow 引擎的 propose→act→critique→select→regression 回合协议，便携 evo skill 随包分发。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./workflow/evo-round.mjs": "./workflow/evo-round.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "workflow",
    "skills",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "gate": "node scripts/gates/run.mjs",
    "gates": "node scripts/gates/run.mjs --list",
    "check": "node --check src/index.mjs && node --check src/evo.mjs && node --check src/ledger.mjs && node --check workflow/evo-round.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlln/evo-engineering.git"
  },
  "homepage": "https://github.com/vlln/evo-engineering#readme",
  "bugs": {
    "url": "https://github.com/vlln/evo-engineering/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "rsi",
    "self-improvement",
    "evolution-engineering",
    "agent",
    "skill"
  ],
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}